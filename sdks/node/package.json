{
  "name": "opslens",
  "version": "0.1.0",
  "description": "OpsLens AI Node.js SDK — push log events into the AI alert pipeline",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run"
  },
  "keywords": ["opslens", "observability", "alerting", "incident-response", "monitoring"],
  "author": "OpsLens AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/opslens-ai/opslens-node"
  },
  "homepage": "https://opslensai.com",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
