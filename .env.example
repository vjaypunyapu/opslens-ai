# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://opslens:opslens@localhost:5432/opslens
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                      # leave blank for local dev

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o

# ─── Auth (Clerk / Auth0) ─────────────────────────────────────────────────────
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_URL=https://your-clerk-or-auth0-domain/.well-known/jwks.json
# Alternatively, paste the PEM directly:
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...

# ─── Airbyte ──────────────────────────────────────────────────────────────────
AIRBYTE_API_URL=http://localhost:8006/api/v1
AIRBYTE_API_KEY=
AIRBYTE_WORKSPACE_ID=
# Optional Airbyte source definition IDs for observability connectors
AIRBYTE_SOURCE_DEF_ELASTICSEARCH=
AIRBYTE_SOURCE_DEF_DATADOG=
AIRBYTE_SOURCE_DEF_CLOUDWATCH=
AIRBYTE_SOURCE_DEF_SPLUNK=
AIRBYTE_SOURCE_DEF_AZURE_MONITOR=
AIRBYTE_SOURCE_DEF_GCP_LOGGING=

# ─── Integrations (OAuth tokens encrypted at rest) ────────────────────────────
CREDENTIALS_ENCRYPTION_KEY=base64-encoded-32-byte-key

# ─── Notifications ────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SENDGRID_API_KEY=SG....
ALERT_EMAIL_FROM=alerts@yourdomain.com

# ─── LangSmith (optional, for tracing) ───────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=opslens-ai

# ─── Sentry (optional, for error tracking) ───────────────────────────────────
SENTRY_DSN=

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
